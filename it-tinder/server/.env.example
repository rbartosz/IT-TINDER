# Konfiguracja serwera IT Tinder
# Skopiuj ten plik do `.env` i uzupełnij wartości:
#   cp .env.example .env

# Port, na którym nasłuchuje serwer Express
PORT=3000

# Sekret do podpisywania tokenów JWT (zmień na losowy ciąg w produkcji)
JWT_SECRET=zmien_mnie_na_dlugi_losowy_ciag

# Ścieżka do pliku bazy danych SQLite (relatywna lub absolutna)
DB_FILE=database.db
